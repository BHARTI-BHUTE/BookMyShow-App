
pipeline {
    agent any

    tools {
        jdk 'jdk17'
        nodejs 'node18'
    }

    environment {
        DOCKER_IMAGE = 'bhartibhute/bookmyshow:v1'
        DOCKER_CREDENTIALS = 'docker'
    }

    stages {

        stage('Clean Workspace') {
            steps {
                cleanWs()
            }
        }

        stage('Checkout from Git') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/BHARTI-BHUTE/BookMyShow-App.git'

                sh 'ls -la'
            }
        }

        stage('Install Dependencies') {
            steps {
                dir('bookmyshow-app') {
                    sh '''
                        if [ -f package-lock.json ]; then
                            npm ci --legacy-peer-deps
                        else
                            npm install --legacy-peer-deps
                        fi
                    '''
                }
            }
        }

        stage('Build Application') {
            steps {
                dir('bookmyshow-app') {
                    sh 'NODE_OPTIONS=--openssl-legacy-provider npm run build'
                }
            }
        }

        stage('Docker Build') {
            steps {
                sh '''
                    docker build -t ${DOCKER_IMAGE} \
                    -f bookmyshow-app/Dockerfile bookmyshow-app
                '''
            }
        }

        stage('Docker Push') {
            steps {
                script {
                    withDockerRegistry(
                        credentialsId: "${DOCKER_CREDENTIALS}",
                        toolName: 'docker'
                    ) {
                        sh 'docker push ${DOCKER_IMAGE}'
                    }
                }
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                sh '''
                    kubectl apply -f namespace.yml
                    kubectl apply -f deployment.yml
                    kubectl apply -f service.yml

                    kubectl rollout status deployment/bms-app \
                    -n bookmyshow --timeout=180s

                    kubectl get pods -n bookmyshow
                    kubectl get services -n bookmyshow
                '''
            }
        }
    }
}
